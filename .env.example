# ============================================================
# CodeBreakers environment variables
# Copy this file to .env.local and fill in real values.
# Variables WITHOUT the VITE_ prefix stay server-side only
# (used by Vercel serverless functions in /api) and are never
# bundled into the client. NEVER prefix secrets with VITE_.
# ============================================================

# --- Ably (server-side only: used by /api/auth-ably to mint tokens) ---
ABLY_API_KEY=your-ably-root-key-here

# --- Vercel KV / Upstash Redis (auto-injected by Vercel when you ---
# --- connect the KV store to the project; pull with `vercel env pull`) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Optional client identifier for Ably presence ---
VITE_ABLY_CLIENT_ID=

# --- Optional: for plain `npm run dev` (no `vercel dev`), forward /api/* to ---
# --- a deployed Vercel URL so the serverless functions work locally.      ---
# VITE_API_PROXY=https://your-project.vercel.app
